# --- Production OAuth 2.0 Environment Variables ---

# Google OAuth 2.0 Configuration
# Console: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://dynamic-scheduler-ten.vercel.app/api/auth/google/callback

# GitHub OAuth 2.0 Configuration
# Console: https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=https://dynamic-scheduler-ten.vercel.app/api/auth/github/callback

# Microsoft Entra ID / Azure OAuth Configuration
# Console: https://portal.azure.com/#blade/Microsoft_AAD_IAM/ActiveDirectoryMenuBlade/RegisteredApps
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=https://dynamic-scheduler-ten.vercel.app/api/auth/microsoft/callback

# Application & Database Configuration
DATABASE_URL=sqlite:///./scheduler.db
JWT_SECRET=super-secret-scheduling-key-2026
